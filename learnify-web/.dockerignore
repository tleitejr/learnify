.git/
.gitignore
.gitattributes

# Docker (evita cópia desnecessária ou conflitos)
Dockerfile*
.dockerignore
docker-compose*

# Editores e IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Sistema operacional
.DS_Store
Thumbs.db

